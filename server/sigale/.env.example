# Sígale backend — copy to server/.env and fill in. NEVER commit real secrets.
# server/.env is git-ignored.

# ── Server ──────────────────────────────────────────────────
PORT=25060

# ── Database (DEDICATED `sigale` DB ONLY) ───────────────────
# db.js reads SIGALE_DB_NAME first, falls back to DB_NAME.
# Standalone server  → set DB_NAME=sigale (leave SIGALE_DB_NAME unset).
# Shared BlackCoffe server → set SIGALE_DB_NAME=sigale alongside
#   BlackCoffe's DB_NAME=defaultdb so the two vars don't conflict.
DB_HOST=
DB_PORT=25060
DB_USER=
DB_PASSWORD=
DB_NAME=sigale
# SIGALE_DB_NAME=sigale   # uncomment only on the shared BlackCoffe server

# Path to the downloaded DigitalOcean CA certificate (SSL verification, ADR §9).
# rejectUnauthorized stays at its secure default — do NOT disable it.
DB_CA_CERT=./certs/ca-certificate.crt

# ── Door-scan hash secret ───────────────────────────────────
# Keys the deterministic HMAC that mints each ticket's validationHash
# (admin.controllers.js). Must be a long random string and kept stable — the
# QR codes already handed out are derived from it. Rotating it invalidates
# every previously minted QR. Falls back to an insecure dev default if unset.
SCAN_HASH_SECRET=

# ── Error notifier (Resend) ─────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL=
FROM_EMAIL=onboarding@resend.dev

# ── Initial organizer seed (node seed/seedOrganizer.js) ─────
# Use a FRESHLY ROTATED password — never the leaked plaintext from ADR-0001.
ORGANIZER_USERNAME=David
ORGANIZER_INITIAL_PASSWORD=
